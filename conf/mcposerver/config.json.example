{
  "mcpServers": {
    "postgres": {
      "command": "uvx",
      "args": [
        "--overrides",
        "/app/conf/uv-overrides.txt",
        "--with",
        "mcp<2",
        "postgres-mcp@0.3.0",
        "--access-mode=restricted",
        "postgresql://postgres:change_me@db:5432/openwebui"
      ]
    }
  }
}
