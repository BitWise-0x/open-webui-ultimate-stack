# secrets — never commit real env files
.env
env/*.env
!env/*.env.example

# mcpo config gets postgres password injected at bootstrap/deploy time — exclude the runtime copy
conf/mcposerver/config.json
# backup written when bootstrap migrates an old config.json (contains the password)
conf/mcposerver/*.bak

# runtime data
data/
logs/
*.log

# macOS
.DS_Store

# editors
.idea/
.vscode/
*.swp
*.swo

**/.DS_Store
*.icloud
.vscode
__pycache__/
*.pyc
node_modules
