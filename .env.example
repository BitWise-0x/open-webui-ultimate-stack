# =============================================================================
# open-webui-ultimate-stack — top-level environment
# Used by: docker-stack-compose.yml (Swarm deploy) — copy to .env before running scripts/deploy-swarm.sh
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Stack identity ---
STACK_NAME=open-webui

# --- Domain / ingress (optional — used by CORS_ALLOW_ORIGIN and Traefik labels if enabled) ---
ROUTER_NAME=openwebui
ROOT_DOMAIN=your.domain.com

# --- Docker Swarm networking ---
# Overlay backend network name (created by deploy-swarm.sh)
BACKEND_NETWORK_NAME=open-webui_backend
# Isolated overlay for the jupyter kernel (created by deploy-swarm.sh)
JUPYTER_NETWORK_NAME=open-webui_jupyter

# --- Data root (Swarm only) ---
# Base path on the Swarm nodes for bind-mounted service data.
# GlusterFS, NFS, or any shared filesystem reachable on every node.
# Example: /mnt/glusterfs/open-webui  |  /srv/data
DATA_ROOT=/mnt/data

# (Optional) Separate mount point for Redis data (high-IOPS / directio).
# Falls back to DATA_ROOT if unset.
# REDIS_DATA_ROOT=/mnt/ssd

# --- Image versions ---
# Back up the database before changing OWUI_TAG (README > Upgrading)
OWUI_TAG=0.12.3
# Must be 4.x
TIKA_TAG=4.1.0-1
